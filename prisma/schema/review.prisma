model Review {
  id         String @id @default(uuid())
  customerId String
  gearId     String
  rating     Int
  comment    String?

  // Relation with user
  user User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  //Relation with Gear
  gear Gear @relation(fields: [gearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@map("reviews")
}
