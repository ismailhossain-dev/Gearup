model User {
    id String @id @default(uuid())
    name String @db.VarChar(255)
    email String @unique
    password String 
    role Role @default(CUSTOMER)
    phone String?
    profilePhoto String?
    status UserStatus @default(ACTIVE)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    gear Gear[]
    @@map("users")
}